# ─────────────────────────────────────────────────────────────
#  Fichier d'exemple de configuration (livrable §13)
#  Copiez ce fichier en « .env » et remplissez les valeurs.
#  NE JAMAIS committer le vrai fichier .env (il contient des secrets).
# ─────────────────────────────────────────────────────────────

# Port d'écoute de l'API
PORT=3000

# Chaîne de connexion MongoDB Atlas
# Format : mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/labo_iot?retryWrites=true&w=majority

# Clé API secrète — l'ESP32 doit l'envoyer dans l'en-tête « x-api-key »
# pour être autorisé à publier des mesures (protection minimale, §11).
API_KEY=change-moi-par-une-cle-secrete

# Origines autorisées pour le CORS (URL du dashboard), séparées par des virgules.
# Utiliser * en développement, l'URL réelle du dashboard en production.
CORS_ORIGIN=*

# Paramètres métier (valeurs par défaut si non fournies par le capteur)
DEVICE_ID=LABO-INFO-01
DEFAULT_THRESHOLD=30
HYSTERESIS=2
